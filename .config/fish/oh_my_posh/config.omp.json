{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "powerline_symbol": "\ue0b0",
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "#858585",
          "background": "#0000000"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "\ue0c6",
          "template": " \uf120 {{ .Name }} ",
          "foreground": "#ffffff",
          "background": "#25578e"
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "#66c4ff",
          "background": "#1f3247",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#193549",
          "background": "#a2c4e0",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#091d2a",
          "background": "#4e94d4",
          "template": " \ue5ff {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#0d92bf",
          "background_templates": [
            "{{ if gt .Code 0 }}#f1184c{{ end }}"
          ],
          "template": " \uea6c ",
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#007ACC",
          "template": "  \u2570->"
        }
      ],
      "newline": true,
      "force": true
    }
  ]
}
